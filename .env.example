# cv-weaver Environment Configuration
# Copy this file to .env and fill in your values.

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# LLM Models (must be pulled in Ollama first)
GENERATION_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# RAG / Similarity Settings
REDUNDANCY_THRESHOLD=0.85

# Structured Outputs (experimental — Ollama >= 0.4.x or compatible cloud endpoint)
# Passes Pydantic JSON Schema directly to Ollama format= for precise schema enforcement.
# If your endpoint doesn't support it, the client falls back to format='json' automatically.
USE_STRUCTURED_OUTPUTS=false

# Application Paths
DATABASE_PATH=data/cv_weaver.db
KNOWLEDGE_BASE_PATH=data/knowledge_base
OUTPUT_PATH=data/outputs
